{
  "protocol": 1,
  "description": "PlumBot 渲染协议清单 —— route、载荷字段、长度额度与文本可读性规则的唯一真源。Kotlin 侧由 checkRenderProtocol 校验一致性；前端 SDK 据此生成类型与运行时 manifest。",
  "text": {
    "contrast": "auto-outline",
    "threshold": 4.5,
    "base": "#1E2430",
    "color": "#E6E6E6"
  },
  "limits": {
    "displayTextMax": 1024,
    "perLayerMaxBytes": 262144,
    "binaryTotalMaxBytes": 1048576,
    "layersMax": 16,
    "totalTextWarn": 262144
  },
  "routes": {
    "status": {
      "featureGate": "status",
      "defaultEngine": "awt",
      "payload": {
        "serverName": "string",
        "tps": "string[]",
        "mspt": "string",
        "usedMem": "int",
        "maxMem": "int",
        "online": "int"
      }
    },
    "playerList": {
      "featureGate": "list",
      "defaultEngine": "awt",
      "payload": {
        "total": "int",
        "players": "{name:string, boundQq:string?, avatarUrl:string?}[]"
      }
    },
    "whitelist": {
      "featureGate": "bind",
      "defaultEngine": "awt",
      "payload": {
        "playerName": "string",
        "qq": "string",
        "avatarUrl": "string?",
        "bindTime": "string?"
      }
    },
    "bindList": {
      "featureGate": "bind",
      "defaultEngine": "awt",
      "payload": {
        "title": "string",
        "players": "string[]",
        "total": "int"
      }
    },
    "help": {
      "featureGate": "help",
      "defaultEngine": "awt",
      "payload": {
        "prefix": "string",
        "lines": "string[]"
      }
    },
    "load": {
      "featureGate": "load",
      "defaultEngine": "awt",
      "payload": {
        "text": "string"
      }
    },
    "unload": {
      "featureGate": "load",
      "defaultEngine": "awt",
      "payload": {
        "text": "string"
      }
    },
    "message": {
      "featureGate": "message",
      "defaultEngine": "awt",
      "payload": {
        "playerName": "string",
        "serverName": "string",
        "message": "string"
      }
    },
    "joinAndLeave": {
      "featureGate": "joinAndLeave",
      "defaultEngine": "awt",
      "payload": {
        "type": "join|leave",
        "playerName": "string",
        "serverName": "string?"
      }
    },
    "changeServer": {
      "featureGate": "joinAndLeave",
      "defaultEngine": "awt",
      "payload": {
        "playerName": "string",
        "originServer": "string",
        "targetServer": "string"
      }
    },
    "death": {
      "featureGate": "death",
      "defaultEngine": "awt",
      "payload": {
        "playerName": "string",
        "serverName": "string",
        "deathMessage": "string"
      }
    },
    "advancement": {
      "featureGate": "advancement",
      "defaultEngine": "awt",
      "payload": {
        "playerName": "string",
        "serverName": "string",
        "advancementTitle": "string"
      }
    },
    "kick": {
      "featureGate": "kick",
      "defaultEngine": "awt",
      "payload": {
        "playerName": "string"
      }
    },
    "console": {
      "featureGate": "remote_console",
      "defaultEngine": "awt",
      "payload": {
        "title": "string?",
        "body": "string",
        "ampersandCodes": "boolean"
      }
    },
    "text": {
      "featureGate": null,
      "defaultEngine": "awt",
      "payload": {
        "title": "string?",
        "body": "string",
        "ampersandCodes": "boolean"
      }
    },
    "hytaleAvatar": {
      "featureGate": "avatar",
      "defaultEngine": "awt",
      "payload": {
        "username": "string",
        "avatarUrl": "string?",
        "fallbackQq": "string?"
      }
    }
  }
}
